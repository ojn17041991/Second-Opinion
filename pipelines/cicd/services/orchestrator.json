{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "languageVersion": "2.0",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "6973506053259582579"
    }
  },
  "parameters": {
    "environment": {
      "type": "string",
      "allowedValues": [
        "dev",
        "prod"
      ],
      "metadata": {
        "description": "Environment name, used as the name suffix."
      }
    },
    "projectName": {
      "type": "string",
      "allowedValues": [
        "so"
      ],
      "metadata": {
        "description": "Project name, shortened for resource naming."
      }
    },
    "containerAppEnvironmentName": {
      "type": "string",
      "metadata": {
        "description": "Name of the Container App Environment."
      }
    },
    "containerRegistryName": {
      "type": "string",
      "metadata": {
        "description": "Name of the Container Registry (without .azurecr.io suffix)."
      }
    },
    "serviceBusName": {
      "type": "string",
      "metadata": {
        "description": "Name of the Service Bus namespace."
      }
    },
    "monitorResourceGroupName": {
      "type": "string",
      "metadata": {
        "description": "Name of the monitor resource group."
      }
    },
    "applicationInsightsName": {
      "type": "string",
      "metadata": {
        "description": "Name of the shared Application Insights component."
      }
    },
    "tag": {
      "type": "string",
      "defaultValue": "latest",
      "metadata": {
        "description": "Container image tag to deploy."
      }
    }
  },
  "variables": {
    "$fxv#0": "{\r\n  \"apis\": [\"Gateway\"],\r\n  \"workers\": []\r\n}\r\n\r\n",
    "servicesJson": "[json(variables('$fxv#0'))]",
    "services": "[concat(map(variables('servicesJson').apis, lambda('name', createObject('name', lambdaVariables('name'), 'externalIngress', true()))), map(variables('servicesJson').workers, lambda('name', createObject('name', lambdaVariables('name'), 'externalIngress', false()))))]"
  },
  "resources": {
    "cae": {
      "existing": true,
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[parameters('containerAppEnvironmentName')]"
    },
    "ai": {
      "existing": true,
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "resourceGroup": "[parameters('monitorResourceGroupName')]",
      "name": "[parameters('applicationInsightsName')]"
    },
    "service": {
      "copy": {
        "name": "service",
        "count": "[length(variables('services'))]"
      },
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[format('service-{0}', variables('services')[copyIndex()].name)]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "environment": {
            "value": "[parameters('environment')]"
          },
          "projectName": {
            "value": "[parameters('projectName')]"
          },
          "serviceName": {
            "value": "[variables('services')[copyIndex()].name]"
          },
          "externalIngress": {
            "value": "[variables('services')[copyIndex()].externalIngress]"
          },
          "containerAppEnvironmentId": {
            "value": "[resourceId('Microsoft.App/managedEnvironments', parameters('containerAppEnvironmentName'))]"
          },
          "containerRegistryName": {
            "value": "[parameters('containerRegistryName')]"
          },
          "applicationInsightsConnectionString": {
            "value": "[reference('ai').ConnectionString]"
          },
          "serviceBusName": {
            "value": "[parameters('serviceBusName')]"
          },
          "tag": {
            "value": "[parameters('tag')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "languageVersion": "2.0",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.48.1.52935",
              "templateHash": "13747121603961673927"
            }
          },
          "parameters": {
            "environment": {
              "type": "string",
              "allowedValues": [
                "dev",
                "prod"
              ],
              "metadata": {
                "description": "Environment name, used as the name suffix."
              }
            },
            "projectName": {
              "type": "string",
              "allowedValues": [
                "so"
              ],
              "metadata": {
                "description": "Project name, shortened for resource naming."
              }
            },
            "serviceName": {
              "type": "string",
              "metadata": {
                "description": "Name of the service to deploy."
              }
            },
            "externalIngress": {
              "type": "bool",
              "defaultValue": false,
              "metadata": {
                "description": "Whether the container app should have external ingress."
              }
            },
            "containerAppEnvironmentId": {
              "type": "string",
              "metadata": {
                "description": "Resource ID of the Container App Environment."
              }
            },
            "containerRegistryName": {
              "type": "string",
              "metadata": {
                "description": "Name of the Container Registry (without .azurecr.io suffix)."
              }
            },
            "applicationInsightsConnectionString": {
              "type": "string",
              "metadata": {
                "description": "Connection string of the shared Application Insights component."
              }
            },
            "serviceBusName": {
              "type": "string",
              "metadata": {
                "description": "Name of the Service Bus namespace."
              }
            },
            "tag": {
              "type": "string",
              "defaultValue": "latest",
              "metadata": {
                "description": "Container image tag to deploy."
              }
            }
          },
          "variables": {
            "containerRegistryServer": "[format('{0}.azurecr.io', parameters('containerRegistryName'))]",
            "serviceNameNormalized": "[toLower(parameters('serviceName'))]",
            "containerImage": "[format('{0}/{1}:{2}', variables('containerRegistryServer'), variables('serviceNameNormalized'), parameters('tag'))]",
            "acrPullRoleDefinitionId": "7f951dda-4ed3-4680-a7ca-43fe172d538d",
            "serviceBusDataSenderRoleId": "69a216fc-b8fb-44d8-bc22-1f3c2cd27a39"
          },
          "resources": {
            "acr": {
              "existing": true,
              "type": "Microsoft.ContainerRegistry/registries",
              "apiVersion": "2023-11-01-preview",
              "name": "[parameters('containerRegistryName')]"
            },
            "sb": {
              "existing": true,
              "type": "Microsoft.ServiceBus/namespaces",
              "apiVersion": "2024-01-01",
              "name": "[parameters('serviceBusName')]"
            },
            "mi": {
              "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
              "apiVersion": "2023-01-31",
              "name": "[format('mi-{0}-{1}-{2}', parameters('projectName'), variables('serviceNameNormalized'), parameters('environment'))]",
              "location": "[resourceGroup().location]"
            },
            "acrRole": {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[resourceId('Microsoft.ContainerRegistry/registries', parameters('containerRegistryName'))]",
              "name": "[guid(resourceId('Microsoft.ContainerRegistry/registries', parameters('containerRegistryName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('mi-{0}-{1}-{2}', parameters('projectName'), variables('serviceNameNormalized'), parameters('environment'))), variables('acrPullRoleDefinitionId'))]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('acrPullRoleDefinitionId'))]",
                "principalId": "[reference('mi').principalId]",
                "principalType": "ServicePrincipal"
              },
              "dependsOn": [
                "mi"
              ]
            },
            "sbRole": {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[resourceId('Microsoft.ServiceBus/namespaces', parameters('serviceBusName'))]",
              "name": "[guid(resourceId('Microsoft.ServiceBus/namespaces', parameters('serviceBusName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('mi-{0}-{1}-{2}', parameters('projectName'), variables('serviceNameNormalized'), parameters('environment'))), variables('serviceBusDataSenderRoleId'))]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('serviceBusDataSenderRoleId'))]",
                "principalId": "[reference('mi').principalId]",
                "principalType": "ServicePrincipal"
              },
              "dependsOn": [
                "mi"
              ]
            },
            "ca": {
              "type": "Microsoft.App/containerApps",
              "apiVersion": "2024-03-01",
              "name": "[format('ca-{0}-{1}-{2}', parameters('projectName'), variables('serviceNameNormalized'), parameters('environment'))]",
              "location": "[resourceGroup().location]",
              "identity": {
                "type": "UserAssigned",
                "userAssignedIdentities": {
                  "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('mi-{0}-{1}-{2}', parameters('projectName'), variables('serviceNameNormalized'), parameters('environment'))))]": {}
                }
              },
              "properties": {
                "managedEnvironmentId": "[parameters('containerAppEnvironmentId')]",
                "configuration": {
                  "ingress": {
                    "external": "[parameters('externalIngress')]",
                    "targetPort": 8080
                  },
                  "registries": [
                    {
                      "server": "[variables('containerRegistryServer')]",
                      "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('mi-{0}-{1}-{2}', parameters('projectName'), variables('serviceNameNormalized'), parameters('environment')))]"
                    }
                  ],
                  "secrets": [
                    {
                      "name": "appinsights-connection-string",
                      "value": "[parameters('applicationInsightsConnectionString')]"
                    }
                  ]
                },
                "template": {
                  "containers": [
                    {
                      "image": "[variables('containerImage')]",
                      "name": "[format('{0}-{1}-container', parameters('projectName'), variables('serviceNameNormalized'))]",
                      "env": [
                        {
                          "name": "AZURE_CLIENT_ID",
                          "value": "[reference('mi').clientId]"
                        },
                        {
                          "name": "ApplicationInsights__ConnectionString",
                          "secretRef": "appinsights-connection-string"
                        }
                      ],
                      "resources": {
                        "cpu": 1,
                        "memory": "2Gi"
                      }
                    }
                  ],
                  "scale": {
                    "minReplicas": 0,
                    "maxReplicas": 1
                  }
                }
              },
              "dependsOn": [
                "acrRole",
                "mi",
                "sbRole"
              ]
            }
          },
          "outputs": {
            "containerAppName": {
              "type": "string",
              "value": "[format('ca-{0}-{1}-{2}', parameters('projectName'), variables('serviceNameNormalized'), parameters('environment'))]"
            },
            "managedIdentityId": {
              "type": "string",
              "value": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('mi-{0}-{1}-{2}', parameters('projectName'), variables('serviceNameNormalized'), parameters('environment')))]"
