        }
      },
      "dependsOn": [
        "ai"
      ]
    }
  },
  "outputs": {
    "servicePrincipalIds": {
      "type": "array",
      "copy": {
        "count": "[length(variables('services'))]",
        "input": "[reference(format('service[{0}]', copyIndex())).outputs.managedIdentityPrincipalId.value]"
      }
    },
    "serviceContainerAppNames": {
      "type": "array",
      "copy": {
        "count": "[length(variables('services'))]",
        "input": "[reference(format('service[{0}]', copyIndex())).outputs.containerAppName.value]"
      }
    }
  }
}