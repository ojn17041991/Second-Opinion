                }
              },
              "properties": {
                "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', format('cae-{0}-{1}', variables('projectName'), parameters('environment')))]",
                "configuration": {
                  "ingress": {
                    "external": false,
                    "targetPort": 8080
                  },
                  "registries": [
                    {
                      "server": "[reference('acr').loginServer]",
                      "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('mi-{0}-{1}', variables('projectName'), parameters('environment')))]"
                    }
                  ]
                },
                "template": {
                  "containers": [
                    {
                      "image": "[format('{0}/placeholder:latest', reference('acr').loginServer)]",
                      "name": "[format('{0}-container', variables('projectName'))]",
                      "resources": {
                        "cpu": "0.25",
                        "memory": "0.5Gi"
                      }
                    }
                  ],
                  "scale": {
                    "minReplicas": 1,
                    "maxReplicas": 2
                  }
                }
              },
              "dependsOn": [
                "acr",
                "cae",
                "mi"
              ]
            }
          },
          "outputs": {
            "containerRegistryName": {
              "type": "string",
              "value": "[format('acr{0}{1}{2}', variables('projectName'), parameters('environment'), variables('uniqueSuffix'))]"
            },
            "containerAppEnvironmentName": {
              "type": "string",
              "value": "[format('cae-{0}-{1}', variables('projectName'), parameters('environment'))]"
            },
            "containerAppName": {
              "type": "string",
              "value": "[format('ca-{0}-{1}', variables('projectName'), parameters('environment'))]"
            },
            "containerAppPrincipalId": {
              "type": "string",
              "value": "[reference('mi').principalId]"
