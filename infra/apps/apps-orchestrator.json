      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "appsMonitor",
      "resourceGroup": "[format('rg-so-monitor-{0}', parameters('environment'))]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "environment": {
            "value": "[parameters('environment')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "languageVersion": "2.0",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.48.1.52935",
              "templateHash": "18285446841307191021"
            }
          },
          "parameters": {
            "environment": {
              "type": "string"
            }
          },
          "variables": {
