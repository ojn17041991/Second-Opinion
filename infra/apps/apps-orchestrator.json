    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "appsRbac",
      "resourceGroup": "[format('rg-so-apps-{0}', parameters('environment'))]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "containerAppPrincipalId": {
            "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, format('rg-so-apps-{0}', parameters('environment'))), 'Microsoft.Resources/deployments', 'apps'), '2025-04-01').outputs.containerAppPrincipalId.value]"
          },
          "containerRegistryName": {
            "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, format('rg-so-apps-{0}', parameters('environment'))), 'Microsoft.Resources/deployments', 'apps'), '2025-04-01').outputs.containerRegistryName.value]"
