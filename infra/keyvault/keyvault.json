{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "13403497866653160964"
    }
  },
  "parameters": {
    "adminPrincipalId": {
      "type": "string",
      "metadata": {
        "description": "Object ID of the user or group allowed to manage secrets."
      }
    }
  },
  "variables": {
    "secretsOfficerRoleId": "b86a8fe4-44ce-4948-aee5-eccb2c155cd7",
    "resourceGroupSplits": "[split(resourceGroup().name, '-')]",
    "environment": "[variables('resourceGroupSplits')[3]]",
    "projectName": "[variables('resourceGroupSplits')[1]]"
  },
  "resources": [
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[format('kv-{0}-{1}', variables('projectName'), variables('environment'))]",
      "location": "[resourceGroup().location]",
      "properties": {
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "tenantId": "[tenant().tenantId]",
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 7
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', format('kv-{0}-{1}', variables('projectName'), variables('environment')))]",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', format('kv-{0}-{1}', variables('projectName'), variables('environment'))), parameters('adminPrincipalId'), variables('secretsOfficerRoleId'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('secretsOfficerRoleId'))]",
        "principalId": "[parameters('adminPrincipalId')]",
        "principalType": "User"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', format('kv-{0}-{1}', variables('projectName'), variables('environment')))]"
      ]
    }
  ],
  "outputs": {
    "keyVaultName": {
      "type": "string",
      "value": "[format('kv-{0}-{1}', variables('projectName'), variables('environment'))]"
    }
  }
}